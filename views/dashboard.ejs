<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>ABC Home Services — Voice Agent Call Logs</title>
  <!-- Google Fonts: Outfit (modern display) & Inter (highly readable sans-serif) -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Outfit:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  
  <style>
    /* CSS Variables for Premium Light Theme & Glassmorphism */
    :root {
      --bg-primary: #f8fafc;
      --bg-secondary: #ffffff;
      --glass-bg: rgba(255, 255, 255, 0.75);
      --glass-border: rgba(15, 23, 42, 0.08);
      --glass-glow: rgba(124, 58, 237, 0.03);
      
      --text-primary: #0f172a;
      --text-secondary: #475569;
      --text-muted: #64748b;
      
      --accent-purple: #7c3aed;
      --accent-purple-glow: rgba(124, 58, 237, 0.15);
      --accent-blue: #2563eb;
      --accent-blue-glow: rgba(37, 99, 235, 0.15);
      --accent-emerald: #059669;
      --accent-emerald-glow: rgba(5, 150, 105, 0.15);
      --accent-rose: #dc2626;
      --accent-rose-glow: rgba(220, 38, 38, 0.15);
      --accent-amber: #d97706;
      --accent-amber-glow: rgba(217, 119, 6, 0.15);
      
      --transition-fast: 0.2s cubic-bezier(0.4, 0, 0.2, 1);
      --transition-smooth: 0.4s cubic-bezier(0.4, 0, 0.2, 1);
      
      --shadow-sm: 0 1px 3px rgba(15, 23, 42, 0.05), 0 1px 2px rgba(15, 23, 42, 0.02);
      --shadow-md: 0 4px 6px -1px rgba(15, 23, 42, 0.08), 0 2px 4px -2px rgba(15, 23, 42, 0.04);
      --shadow-lg: 0 10px 15px -3px rgba(15, 23, 42, 0.05), 0 4px 6px -4px rgba(15, 23, 42, 0.02);
      --shadow-glow: 0 0 25px rgba(124, 58, 237, 0.08);
    }

    /* Reset and Layout */
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      font-family: 'Inter', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
      background-color: var(--bg-primary);
      background-image: 
        radial-gradient(circle at 10% 20%, rgba(99, 102, 241, 0.04) 0%, transparent 40%),
        radial-gradient(circle at 90% 80%, rgba(139, 92, 246, 0.05) 0%, transparent 40%);
      background-attachment: fixed;
      color: var(--text-primary);
      min-height: 100vh;
      overflow-x: hidden;
      line-height: 1.5;
    }

    .app-container {
      max-width: 1400px;
      margin: 0 auto;
      padding: 2.5rem 1.5rem;
    }

    /* Header styling */
    header {
      margin-bottom: 2.5rem;
      display: flex;
      justify-content: space-between;
      align-items: center;
      position: relative;
    }

    .header-info h1 {
      font-family: 'Outfit', sans-serif;
      font-size: 2.25rem;
      font-weight: 800;
      letter-spacing: -0.03em;
      background: linear-gradient(135deg, #0f172a 30%, #7c3aed 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      margin-bottom: 0.35rem;
    }

    .header-info p {
      color: var(--text-secondary);
      font-size: 0.95rem;
      display: flex;
      align-items: center;
      flex-wrap: wrap;
      gap: 0.5rem;
    }

    .header-info p::before {
      content: '';
      display: inline-block;
      width: 8px;
      height: 8px;
      background-color: var(--accent-emerald);
      border-radius: 50%;
      box-shadow: 0 0 8px var(--accent-emerald-glow);
    }

    .agent-number-badge {
      display: inline-flex;
      align-items: center;
      background: rgba(124, 58, 237, 0.06);
      border: 1px solid rgba(124, 58, 237, 0.15);
      color: var(--accent-purple);
      padding: 0.25rem 0.65rem;
      border-radius: 20px;
      font-size: 0.8rem;
      font-weight: 500;
      margin-left: 0.5rem;
    }
    
    .agent-number-badge strong {
      font-weight: 600;
      margin-left: 0.25rem;
    }

    .header-actions {
      display: flex;
      gap: 0.75rem;
    }

    .btn-refresh {
      background: var(--glass-bg);
      border: 1px solid var(--glass-border);
      color: var(--text-primary);
      padding: 0.75rem 1.25rem;
      border-radius: 12px;
      font-weight: 500;
      font-size: 0.9rem;
      cursor: pointer;
      display: flex;
      align-items: center;
      gap: 0.5rem;
      transition: var(--transition-fast);
      box-shadow: var(--shadow-sm);
    }

    .btn-refresh:hover {
      background: rgba(15, 23, 42, 0.03);
      border-color: rgba(15, 23, 42, 0.15);
      transform: translateY(-2px);
    }

    .btn-refresh:active {
      transform: translateY(0);
    }

    /* Key Stats Grid Dashboard */
    .stats-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
      gap: 1.5rem;
      margin-bottom: 3rem;
    }

    .stat-card {
      background: var(--glass-bg);
      border: 1px solid var(--glass-border);
      border-radius: 20px;
      padding: 1.5rem;
      display: flex;
      align-items: center;
      gap: 1.25rem;
      position: relative;
      overflow: hidden;
      box-shadow: var(--shadow-md);
      transition: var(--transition-smooth);
    }

    .stat-card:hover {
      transform: translateY(-5px);
      border-color: rgba(124, 58, 237, 0.25);
      box-shadow: var(--shadow-lg), var(--glass-glow);
    }

    .stat-card::before {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 4px;
      background: linear-gradient(90deg, transparent, var(--accent-purple), transparent);
      opacity: 0;
      transition: var(--transition-smooth);
    }

    .stat-card:hover::before {
      opacity: 1;
    }

    .stat-icon {
      width: 54px;
      height: 54px;
      border-radius: 14px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 1.5rem;
      flex-shrink: 0;
    }

    .stat-icon.total {
      background: rgba(37, 99, 235, 0.08);
      color: var(--accent-blue);
      border: 1px solid rgba(37, 99, 235, 0.15);
    }

    .stat-icon.booking {
      background: rgba(5, 150, 105, 0.08);
      color: var(--accent-emerald);
      border: 1px solid rgba(5, 150, 105, 0.15);
    }

    .stat-icon.emergency {
      background: rgba(220, 38, 38, 0.08);
      color: var(--accent-rose);
      border: 1px solid rgba(220, 38, 38, 0.15);
      animation: pulse-glow 2.5s infinite;
    }

    .stat-icon.duration {
      background: rgba(217, 119, 6, 0.08);
      color: var(--accent-amber);
      border: 1px solid rgba(217, 119, 6, 0.15);
    }

    .stat-info {
      display: flex;
      flex-direction: column;
    }

    .stat-label {
      color: var(--text-secondary);
      font-size: 0.85rem;
      font-weight: 500;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      margin-bottom: 0.25rem;
    }

    .stat-value {
      font-family: 'Outfit', sans-serif;
      font-size: 1.75rem;
      font-weight: 700;
      color: var(--text-primary);
      line-height: 1.2;
    }

    /* Main Table Section */
    .table-container {
      background: var(--glass-bg);
      border: 1px solid var(--glass-border);
      border-radius: 24px;
      overflow: hidden;
      box-shadow: var(--shadow-lg);
      backdrop-filter: blur(20px);
      -webkit-backdrop-filter: blur(20px);
      margin-bottom: 2rem;
      position: relative;
    }

    .table-responsive {
      width: 100%;
      overflow-x: auto;
    }

    table {
      width: 100%;
      border-collapse: collapse;
      text-align: left;
    }

    th {
      font-family: 'Outfit', sans-serif;
      background: rgba(241, 245, 249, 0.8);
      padding: 1.15rem 1.5rem;
      font-size: 0.85rem;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      color: var(--text-secondary);
      border-bottom: 1px solid var(--glass-border);
    }

    td {
      padding: 1.15rem 1.5rem;
      font-size: 0.92rem;
      border-bottom: 1px solid var(--glass-border);
      color: var(--text-primary);
      transition: var(--transition-fast);
    }

    tr {
      cursor: pointer;
      transition: var(--transition-fast);
    }

    tr:last-child td {
      border-bottom: none;
    }

    tr:hover td {
      background: rgba(124, 58, 237, 0.03);
      color: var(--text-primary);
    }

    /* Date and Customer Styling */
    .col-customer {
      font-weight: 600;
      color: var(--text-primary);
    }

    .col-phone {
      font-family: monospace;
      color: var(--text-secondary);
      font-size: 0.9rem;
    }

    .col-date {
      font-size: 0.85rem;
      color: var(--text-secondary);
    }

    /* Badges */
    .badge {
      display: inline-flex;
      align-items: center;
      gap: 0.35rem;
      padding: 0.35rem 0.75rem;
      border-radius: 20px;
      font-size: 0.75rem;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.03em;
    }

    .badge-booking_request {
      background: rgba(5, 150, 105, 0.08);
      color: var(--accent-emerald);
      border: 1px solid rgba(5, 150, 105, 0.15);
    }

    .badge-emergency {
      background: rgba(220, 38, 38, 0.08);
      color: var(--accent-rose);
      border: 1px solid rgba(220, 38, 38, 0.2);
      box-shadow: 0 0 10px rgba(220, 38, 38, 0.08);
      font-weight: 700;
    }

    .badge-pricing_question {
      background: rgba(124, 58, 237, 0.08);
      color: var(--accent-purple);
      border: 1px solid rgba(124, 58, 237, 0.15);
    }

    .badge-service_area_question {
      background: rgba(37, 99, 235, 0.08);
      color: var(--accent-blue);
      border: 1px solid rgba(37, 99, 235, 0.15);
    }

    .badge-unknown {
      background: rgba(100, 116, 139, 0.08);
      color: var(--text-secondary);
      border: 1px solid rgba(100, 116, 139, 0.15);
    }

    /* Action button */
    .btn-view {
      background: rgba(15, 23, 42, 0.03);
      border: 1px solid var(--glass-border);
      color: var(--text-primary);
      padding: 0.45rem 0.9rem;
      border-radius: 8px;
      font-size: 0.8rem;
      font-weight: 500;
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      gap: 0.35rem;
      transition: var(--transition-fast);
    }

    .btn-view:hover {
      background: var(--accent-purple);
      border-color: var(--accent-purple);
      color: #ffffff;
      box-shadow: 0 0 15px var(--accent-purple-glow);
    }

    /* Empty state card */
    .empty-state {
      padding: 5rem 2rem;
      text-align: center;
      color: var(--text-secondary);
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 1rem;
    }

    .empty-icon {
      font-size: 3rem;
      color: var(--text-muted);
      margin-bottom: 0.5rem;
    }

    .empty-state h3 {
      font-family: 'Outfit', sans-serif;
      font-size: 1.5rem;
      color: var(--text-primary);
    }

    /* Pagination controls */
    .pagination-bar {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 1.25rem 1.5rem;
      border-top: 1px solid var(--glass-border);
      background: rgba(248, 250, 252, 0.8);
      font-size: 0.88rem;
      color: var(--text-secondary);
    }

    .pagination-controls {
      display: flex;
      align-items: center;
      gap: 0.5rem;
    }

    .btn-page {
      background: rgba(15, 23, 42, 0.03);
      border: 1px solid var(--glass-border);
      color: var(--text-primary);
      padding: 0.5rem 1rem;
      border-radius: 8px;
      cursor: pointer;
      font-weight: 500;
      transition: var(--transition-fast);
      display: inline-flex;
      align-items: center;
      gap: 0.35rem;
      text-decoration: none;
    }

    .btn-page:hover:not(.disabled) {
      background: rgba(15, 23, 42, 0.06);
      border-color: var(--text-secondary);
    }

    .btn-page.active {
      background: var(--accent-purple);
      border-color: var(--accent-purple);
      color: #ffffff;
      box-shadow: 0 0 10px var(--accent-purple-glow);
    }

    .btn-page.disabled {
      opacity: 0.4;
      cursor: not-allowed;
      pointer-events: none;
    }

    /* Details slide-out drawer style */
    .drawer-overlay {
      position: fixed;
      top: 0;
      left: 0;
      width: 100vw;
      height: 100vh;
      background: rgba(15, 23, 42, 0.3);
      backdrop-filter: blur(8px);
      -webkit-backdrop-filter: blur(8px);
      z-index: 100;
      opacity: 0;
      visibility: hidden;
      transition: var(--transition-smooth);
    }

    .drawer-overlay.active {
      opacity: 1;
      visibility: visible;
    }

    .details-drawer {
      position: fixed;
      top: 0;
      right: -550px;
      width: 550px;
      max-width: 100%;
      height: 100vh;
      background: #ffffff;
      border-left: 1px solid var(--glass-border);
      z-index: 101;
      box-shadow: -10px 0 40px rgba(15, 23, 42, 0.08);
      transition: right var(--transition-smooth);
      display: flex;
      flex-direction: column;
    }

    .details-drawer.active {
      right: 0;
    }

    .drawer-header {
      padding: 1.5rem;
      border-bottom: 1px solid var(--glass-border);
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      background: rgba(248, 250, 252, 0.95);
    }

    .drawer-title-group h2 {
      font-family: 'Outfit', sans-serif;
      font-size: 1.35rem;
      font-weight: 700;
      color: var(--text-primary);
      margin-bottom: 0.35rem;
    }

    .drawer-title-group p {
      font-size: 0.85rem;
      color: var(--text-secondary);
      font-family: monospace;
    }

    .btn-close-drawer {
      background: rgba(15, 23, 42, 0.04);
      border: 1px solid var(--glass-border);
      width: 36px;
      height: 36px;
      border-radius: 50%;
      color: var(--text-primary);
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 1.25rem;
      cursor: pointer;
      transition: var(--transition-fast);
    }

    .btn-close-drawer:hover {
      background: rgba(15, 23, 42, 0.08);
      color: var(--text-primary);
    }

    /* Drawer Scrollable Content */
    .drawer-body {
      flex: 1;
      overflow-y: auto;
      padding: 1.5rem;
      display: flex;
      flex-direction: column;
      gap: 1.75rem;
    }

    /* Drawer Sections */
    .drawer-section-title {
      font-family: 'Outfit', sans-serif;
      font-size: 0.95rem;
      font-weight: 700;
      color: var(--text-primary);
      text-transform: uppercase;
      letter-spacing: 0.05em;
      margin-bottom: 0.75rem;
      display: flex;
      align-items: center;
      gap: 0.5rem;
    }

    .drawer-section-title::after {
      content: '';
      flex: 1;
      height: 1px;
      background: var(--glass-border);
    }

    /* Metadata details grid */
    .drawer-meta-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 1rem;
      background: rgba(15, 23, 42, 0.02);
      border: 1px solid var(--glass-border);
      padding: 1.25rem;
      border-radius: 16px;
    }

    .meta-item {
      display: flex;
      flex-direction: column;
      gap: 0.25rem;
    }

    .meta-label {
      font-size: 0.75rem;
      color: var(--text-secondary);
      font-weight: 500;
      text-transform: uppercase;
      letter-spacing: 0.02em;
    }

    .meta-value {
      font-size: 0.9rem;
      color: var(--text-primary);
      font-weight: 600;
    }

    /* Recording Section Player */
    .recording-card {
      background: rgba(124, 58, 237, 0.04);
      border: 1px solid rgba(124, 58, 237, 0.12);
      padding: 1.25rem;
      border-radius: 16px;
      display: flex;
      flex-direction: column;
      gap: 0.75rem;
      box-shadow: inset 0 0 10px rgba(124, 58, 237, 0.02);
    }

    audio {
      width: 100%;
      height: 40px;
      outline: none;
    }

    /* Summary Card */
    .summary-card {
      background: rgba(15, 23, 42, 0.02);
      border: 1px solid var(--glass-border);
      padding: 1.25rem;
      border-radius: 16px;
      font-size: 0.92rem;
      color: var(--text-primary);
      line-height: 1.6;
    }

    /* Chat bubble system in EJS details */
    .chat-container {
      display: flex;
      flex-direction: column;
      gap: 1rem;
    }

    .chat-message {
      display: flex;
      flex-direction: column;
      max-width: 85%;
    }

    .chat-message.assistant {
      align-self: flex-start;
    }

    .chat-message.user {
      align-self: flex-end;
    }

    .chat-bubble {
      padding: 0.85rem 1.15rem;
      border-radius: 18px;
      font-size: 0.9rem;
      line-height: 1.5;
    }

    .chat-message.assistant .chat-bubble {
      background: #f1f5f9;
      color: var(--text-primary);
      border-bottom-left-radius: 4px;
      border: 1px solid rgba(15, 23, 42, 0.04);
    }

    .chat-message.user .chat-bubble {
      background: var(--accent-purple);
      color: #ffffff;
      border-bottom-right-radius: 4px;
      box-shadow: 0 4px 10px rgba(124, 58, 237, 0.15);
    }

    .chat-meta {
      font-size: 0.75rem;
      color: var(--text-muted);
      margin-top: 0.3rem;
      font-weight: 500;
      padding: 0 0.25rem;
    }

    .chat-message.user .chat-meta {
      text-align: right;
    }

    /* Raw Payload Accordion */
    .accordion-toggle {
      background: rgba(15, 23, 42, 0.02);
      border: 1px solid var(--glass-border);
      padding: 1rem 1.25rem;
      border-radius: 12px;
      color: var(--text-secondary);
      font-size: 0.88rem;
      cursor: pointer;
      display: flex;
      justify-content: space-between;
      align-items: center;
      transition: var(--transition-fast);
      user-select: none;
    }

    .accordion-toggle:hover {
      background: rgba(15, 23, 42, 0.05);
      color: var(--text-primary);
    }

    .accordion-content {
      max-height: 0;
      overflow: hidden;
      transition: max-height var(--transition-smooth);
      background: rgba(15, 23, 42, 0.02);
      border-radius: 0 0 12px 12px;
    }

    .accordion-content.active {
      max-height: 300px;
      border: 1px solid var(--glass-border);
      border-top: none;
      overflow-y: auto;
    }

    pre {
      padding: 1.25rem;
      font-family: monospace;
      font-size: 0.78rem;
      color: #4f46e5;
      background: #f8fafc;
      white-space: pre-wrap;
      word-break: break-all;
      border-radius: 0 0 12px 12px;
    }

    /* Pulsing animations */
    @keyframes pulse-glow {
      0% {
        box-shadow: 0 0 0 0 rgba(239, 68, 68, 0.4);
      }
      70% {
        box-shadow: 0 0 0 8px rgba(239, 68, 68, 0);
      }
      100% {
        box-shadow: 0 0 0 0 rgba(239, 68, 68, 0);
      }
    }

    /* Responsive scaling */
    @media (max-width: 768px) {
      .app-container {
        padding: 1.5rem 1rem;
      }
      header {
        flex-direction: column;
        align-items: flex-start;
        gap: 1rem;
      }
      .details-drawer {
        width: 100%;
        right: -100%;
      }
      .drawer-meta-grid {
        grid-template-columns: 1fr;
      }
      .stats-grid {
        grid-template-columns: 1fr;
      }
    }

    /* SMS Delivery Alert styling */
    .sms-alert-card {
      padding: 1.25rem;
      border-radius: 16px;
      display: flex;
      flex-direction: column;
      gap: 0.35rem;
      box-shadow: var(--shadow-sm);
      border: 1px solid transparent;
      transition: var(--transition-fast);
      margin-bottom: 1.5rem;
    }
    
    .sms-alert-card.success {
      background: rgba(5, 150, 105, 0.06);
      border-color: rgba(5, 150, 105, 0.2);
      color: #059669;
      box-shadow: 0 0 15px rgba(5, 150, 105, 0.05);
    }
    
    .sms-alert-card.failed {
      background: rgba(220, 38, 38, 0.06);
      border-color: rgba(220, 38, 38, 0.2);
      color: #dc2626;
      box-shadow: 0 0 15px rgba(220, 38, 38, 0.05);
    }
    
    .sms-alert-card.pending {
      background: rgba(217, 119, 6, 0.06);
      border-color: rgba(217, 119, 6, 0.2);
      color: #d97706;
      box-shadow: 0 0 15px rgba(217, 119, 6, 0.05);
    }
  </style>
</head>
<body>

  <div class="app-container">
    
    <header>
      <div class="header-info">
        <h1>ABC Home Services</h1>
        <p>
          Voice AI Receptionist Console
          <span class="agent-number-badge">
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="margin-right: 4px;">
              <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>
            </svg>
            Agent Number: <strong>+1 (541) 834 9925</strong>
          </span>
        </p>
      </div>
      <div class="header-actions">
        <button class="btn-refresh" onclick="window.location.reload()">
          <!-- Refresh SVG -->
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M21.5 2v6h-6M21.34 15.57a10 10 0 1 1-.57-8.38l5.67-5.67"/>
          </svg>
          Refresh Logs
        </button>
      </div>
    </header>

    <!-- Stat Dashboard Cards -->
    <section class="stats-grid">
      
      <div class="stat-card">
        <div class="stat-icon total">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>
          </svg>
        </div>
        <div class="stat-info">
          <span class="stat-label">Total Calls</span>
          <span class="stat-value"><%= stats.totalCalls %></span>
        </div>
      </div>

      <div class="stat-card">
        <div class="stat-icon booking">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect x="3" y="4" width="18" height="18" rx="2" ry="2"/>
            <line x1="16" y1="2" x2="16" y2="6"/>
            <line x1="8" y1="2" x2="8" y2="6"/>
            <line x1="3" y1="10" x2="21" y2="10"/>
          </svg>
        </div>
        <div class="stat-info">
          <span class="stat-label">Booking Requests</span>
          <span class="stat-value"><%= stats.bookingCalls %></span>
        </div>
      </div>

      <div class="stat-card">
        <div class="stat-icon emergency">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3Z"/>
            <line x1="12" y1="9" x2="12" y2="13"/>
            <line x1="12" y1="17" x2="12.01" y2="17"/>
          </svg>
        </div>
        <div class="stat-info">
          <span class="stat-label">Emergencies</span>
          <span class="stat-value" style="color: var(--accent-rose)"><%= stats.emergencyCalls %></span>
        </div>
      </div>

      <div class="stat-card">
        <div class="stat-icon duration">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="10"/>
            <polyline points="12 6 12 12 16 14"/>
          </svg>
        </div>
        <div class="stat-info">
          <span class="stat-label">Avg Duration</span>
          <span class="stat-value"><%= stats.avgDuration %>s</span>
        </div>
      </div>

    </section>

    <!-- Calls Logs Table Card -->
    <div class="table-container">
      <div class="table-responsive">
        <table>
          <thead>
            <tr>
              <th>Timestamp</th>
              <th>Customer</th>
              <th>Phone</th>
              <th>Service Needed</th>
              <th>Preferred Time</th>
              <th>Duration</th>
              <th>Emergency</th>
              <th>City / Area</th>
              <th>Intent Category</th>
              <th>Action</th>
            </tr>
          </thead>
          <tbody>
            <% if (logs && logs.length > 0) { %>
              <% logs.forEach(log => { %>
                <tr onclick="viewCallDetails(this)" data-log='<%= JSON.stringify(log).replace(/'/g, "&#39;") %>'>
                  <td class="col-date">
                    <%= new Date(log.createdAt).toLocaleString('en-US', { month: 'short', day: 'numeric', hour: '2-digit', minute: '2-digit' }) %>
                  </td>
                  <td class="col-customer">
                    <%= log.customerName || 'Unknown Caller' %>
                  </td>
                  <td class="col-phone">
                    <%= log.callerPhone || '—' %>
                  </td>
                  <td>
                    <%= log.serviceNeeded || '—' %>
                  </td>
                  <td style="color: var(--accent-amber); font-weight: 500;">
                    <%= log.preferredTime || '—' %>
                  </td>
                  <td style="font-family: monospace;">
                    <%= log.durationSeconds ? Number(log.durationSeconds).toFixed(1) + 's' : '—' %>
                  </td>
                  <td>
                    <% if (log.isEmergency) { %>
                      <span class="badge badge-emergency" style="padding: 0.25rem 0.5rem; font-size: 0.7rem;">YES</span>
                    <% } else { %>
                      <span style="color: var(--text-muted); font-size: 0.85rem; font-weight: 500; padding-left: 0.5rem;">NO</span>
                    <% } %>
                  </td>
                  <td>
                    <%= log.addressOrCity || '—' %>
                  </td>
                  <td>
                    <span class="badge badge-<%= log.intent %>">
                      <%= log.intent.replace('_', ' ') %>
                    </span>
                  </td>
                  <td>
                    <button class="btn-view">
                      View details
                    </button>
                  </td>
                </tr>
              <% }) %>
            <% } else { %>
              <tr>
                <td colspan="10">
                  <div class="empty-state">
                    <div class="empty-icon">📂</div>
                    <h3>No Call Logs Available</h3>
                    <p>When Vapi call webhooks trigger, logs will populate here dynamically.</p>
                  </div>
                </td>
              </tr>
            <% } %>
          </tbody>

        </table>
      </div>

      <!-- Pagination bar at the bottom of EJS table -->
      <div class="pagination-bar">
        <div>
          Showing calls <strong><%= (currentPage - 1) * limit + 1 %></strong> to <strong><%= Math.min(currentPage * limit, totalCount) %></strong> of <strong><%= totalCount %></strong> logs
        </div>
        
        <div class="pagination-controls">
          <!-- Previous Button -->
          <a href="?page=<%= currentPage - 1 %>&limit=<%= limit %>" class="btn-page <%= currentPage <= 1 ? 'disabled' : '' %>">
            &laquo; Previous
          </a>

          <!-- Page buttons -->
          <% for(let i = 1; i <= totalPages; i++) { %>
            <a href="?page=<%= i %>&limit=<%= limit %>" class="btn-page <%= currentPage === i ? 'active' : '' %>">
              <%= i %>
            </a>
          <% } %>

          <!-- Next Button -->
          <a href="?page=<%= currentPage + 1 %>&limit=<%= limit %>" class="btn-page <%= currentPage >= totalPages ? 'disabled' : '' %>">
            Next &raquo;
          </a>
        </div>
      </div>

    </div>

  </div>

  <!-- Background overlay for details drawer -->
  <div class="drawer-overlay" id="drawerOverlay" onclick="closeDrawer()"></div>

  <!-- Sliding drawer for Call Details -->
  <div class="details-drawer" id="detailsDrawer">
    <div class="drawer-header">
      <div class="drawer-title-group">
        <h2 id="drawerCustomerName">Customer details</h2>
        <p id="drawerCallId">ID: unknown</p>
      </div>
      <button class="btn-close-drawer" onclick="closeDrawer()">✕</button>
    </div>

    <div class="drawer-body">
      
      <!-- Statistics/Meta list -->
      <div>
        <h3 class="drawer-section-title">Call Details</h3>
        <div class="drawer-meta-grid">
          <div class="meta-item">
            <span class="meta-label">Phone</span>
            <span class="meta-value" id="drawerPhone">—</span>
          </div>
          <div class="meta-item">
            <span class="meta-label">Intent</span>
            <span class="meta-value" id="drawerIntentBadge">—</span>
          </div>
          <div class="meta-item">
            <span class="meta-label">Duration</span>
            <span class="meta-value" id="drawerDuration">—</span>
          </div>
          <div class="meta-item">
            <span class="meta-label">End Reason</span>
            <span class="meta-value" id="drawerEndReason">—</span>
          </div>
          <div class="meta-item">
            <span class="meta-label">Service Needed</span>
            <span class="meta-value" id="drawerServiceNeeded">—</span>
          </div>
          <div class="meta-item">
            <span class="meta-label">Preferred Time</span>
            <span class="meta-value" id="drawerPreferredTime">—</span>
          </div>
          <div class="meta-item" style="grid-column: span 2;">
            <span class="meta-label">Service Address/City</span>
            <span class="meta-value" id="drawerAddress">—</span>
          </div>
        </div>
      </div>

      <!-- Emergency Agent SMS Dispatch Card -->
      <div id="drawerSmsContainer" style="display: none;">
        <div id="drawerSmsCard" class="sms-alert-card">
          <div style="display: flex; align-items: center; gap: 0.5rem; font-weight: 700; font-size: 0.95rem; font-family: 'Outfit', sans-serif;">
            <span id="drawerSmsIcon">🟢</span>
            <span id="drawerSmsTitle">Emergency Alert Status</span>
          </div>
          <p id="drawerSmsText" style="font-size: 0.88rem; opacity: 0.95; line-height: 1.4; margin-top: 0.25rem; font-weight: 500;">
            —
          </p>
        </div>
      </div>

      <!-- Call Recording Player -->
      <div id="drawerRecordingContainer" class="recording-card" style="display: none;">
        <h3 class="drawer-section-title" style="margin-bottom: 0.25rem;">Call Recording</h3>
        <audio id="drawerAudioPlayer" controls></audio>
      </div>

      <!-- AI Summary -->
      <div>
        <h3 class="drawer-section-title">Call Summary</h3>
        <div class="summary-card" id="drawerSummary">
          No summary extracted.
        </div>
      </div>

      <!-- Conversational Transcript (chat bubbles) -->
      <div>
        <h3 class="drawer-section-title">Call Transcript</h3>
        <div class="chat-container" id="drawerTranscript">
          <!-- Populated by JS -->
        </div>
      </div>

      <!-- Technical Raw details accordion -->
      <div>
        <div class="accordion-toggle" onclick="toggleAccordion()">
          <span>Raw Database Payload</span>
          <span id="accordionArrow">▼</span>
        </div>
        <div class="accordion-content" id="accordionContent">
          <pre id="drawerRawPayload">Loading...</pre>
        </div>
      </div>

    </div>
  </div>

  <script>
    // Client-side handlers for interactive slide drawer
    function viewCallDetails(rowElement) {
      try {
        const logDataString = rowElement.getAttribute('data-log');
        const log = JSON.parse(logDataString);
        
        // Populate metadata
        document.getElementById('drawerCustomerName').innerText = log.customerName || 'Unknown Caller';
        document.getElementById('drawerCallId').innerText = 'ID: ' + log.callId;
        document.getElementById('drawerPhone').innerText = log.callerPhone || '—';
        document.getElementById('drawerDuration').innerText = log.durationSeconds ? Number(log.durationSeconds).toFixed(1) + ' seconds' : '—';
        document.getElementById('drawerEndReason').innerText = log.endedReason || 'Completed';
        document.getElementById('drawerServiceNeeded').innerText = log.serviceNeeded || '—';
        document.getElementById('drawerPreferredTime').innerText = log.preferredTime || '—';
        document.getElementById('drawerAddress').innerText = log.addressOrCity || '—';
        
        // Intent badge formatting
        const badgeSpan = document.getElementById('drawerIntentBadge');
        badgeSpan.className = 'badge badge-' + log.intent;
        badgeSpan.innerText = log.intent.replace('_', ' ');
        
        // Audio recording player setup
        const recCard = document.getElementById('drawerRecordingContainer');
        const audio = document.getElementById('drawerAudioPlayer');
        if (log.recordingUrl && log.recordingUrl.trim()) {
          audio.src = log.recordingUrl.trim();
          recCard.style.display = 'flex';
        } else {
          audio.src = '';
          recCard.style.display = 'none';
        }
        
        // Emergency SMS alert display status
        const smsContainer = document.getElementById('drawerSmsContainer');
        const smsCard = document.getElementById('drawerSmsCard');
        const smsIcon = document.getElementById('drawerSmsIcon');
        const smsTitle = document.getElementById('drawerSmsTitle');
        const smsText = document.getElementById('drawerSmsText');

        if (log.isEmergency) {
          smsContainer.style.display = 'block';
          smsCard.className = 'sms-alert-card'; // Reset classes
          
          if (log.smsDelivered === true) {
            smsCard.classList.add('success');
            smsIcon.innerText = '🟢';
            smsTitle.innerText = 'SMS Emergency Alert Delivered';
            smsText.innerText = 'Emergency notification SMS was successfully sent and delivered to our active service agent.';
          } else if (log.smsDelivered === false) {
            smsCard.classList.add('failed');
            smsIcon.innerText = '🔴';
            smsTitle.innerText = 'SMS Emergency Alert Failed';
            smsText.innerText = 'Warning: The emergency notification SMS failed to deliver to the agent. Please contact manually if necessary.';
          } else {
            smsCard.classList.add('pending');
            smsIcon.innerText = '🟡';
            smsTitle.innerText = 'SMS Emergency Alert Status Pending';
            smsText.innerText = 'Emergency notification SMS dispatch is in progress or delivery confirmation is pending.';
          }
        } else {
          smsContainer.style.display = 'none';
        }

        // Summary
        document.getElementById('drawerSummary').innerText = log.summary || 'No summary generated.';
        
        // Formatted transcript rendering
        renderTranscript(log.transcript);

        // Raw Payload formatting
        document.getElementById('drawerRawPayload').innerText = JSON.stringify(log, null, 2);
        
        // Expand drawer & overlay
        document.getElementById('drawerOverlay').classList.add('active');
        document.getElementById('detailsDrawer').classList.add('active');
      } catch (err) {
        console.error("Failed to parse log data in UI:", err);
      }
    }

    function closeDrawer() {
      // Pause audio player
      const audio = document.getElementById('drawerAudioPlayer');
      audio.pause();
      audio.src = '';

      // Deactivate drawer & overlay
      document.getElementById('drawerOverlay').classList.remove('active');
      document.getElementById('detailsDrawer').classList.remove('active');

      // Reset raw payload accordion
      const content = document.getElementById('accordionContent');
      content.classList.remove('active');
      document.getElementById('accordionArrow').innerText = '▼';
    }

    // Dynamic transcript chat bubble parser
    function renderTranscript(transcriptText) {
      const container = document.getElementById('drawerTranscript');
      container.innerHTML = '';
      if (!transcriptText || !transcriptText.trim()) {
        container.innerHTML = '<div style="color: var(--text-secondary); text-align: center; padding: 1.5rem; font-style: italic;">No transcript recorded.</div>';
        return;
      }
      
      const lines = transcriptText.split('\n');
      lines.forEach(line => {
        if (!line.trim()) return;
        
        let role = 'unknown';
        let content = line;
        
        if (line.startsWith('AI:') || line.startsWith('Bot:')) {
          role = 'assistant';
          content = line.replace(/^(AI:|Bot:)\s*/, '');
        } else if (line.startsWith('User:') || line.startsWith('Caller:')) {
          role = 'user';
          content = line.replace(/^(User:|Caller:)\s*/, '');
        } else {
          // Detect generic prefix e.g., Agent: hello
          const match = line.match(/^([^:]+):\s*(.*)$/);
          if (match) {
            const possibleRole = match[1].toLowerCase();
            if (possibleRole.includes('ai') || possibleRole.includes('bot') || possibleRole.includes('assistant') || possibleRole.includes('agent')) {
              role = 'assistant';
            } else {
              role = 'user';
            }
            content = match[2];
          }
        }
        
        const msgDiv = document.createElement('div');
        msgDiv.className = 'chat-message ' + role;
        
        const bubble = document.createElement('div');
        bubble.className = 'chat-bubble';
        bubble.innerText = content;
        
        const meta = document.createElement('div');
        meta.className = 'chat-meta';
        meta.innerText = role === 'assistant' ? 'AI Assistant' : 'Customer';
        
        msgDiv.appendChild(bubble);
        msgDiv.appendChild(meta);
        container.appendChild(msgDiv);
      });
    }

    // Toggle raw database accordion
    function toggleAccordion() {
      const content = document.getElementById('accordionContent');
      const arrow = document.getElementById('accordionArrow');
      const isActive = content.classList.toggle('active');
      arrow.innerText = isActive ? '▲' : '▼';
    }

    // Stop row click event bubbles from action button (so row trigger doesn't trigger twice)
    document.querySelectorAll('.btn-view').forEach(btn => {
      btn.addEventListener('click', (e) => {
        e.stopPropagation();
        viewCallDetails(btn.closest('tr'));
      });
    });
  </script>
</body>
</html>
